    letter-spacing: -0.045em;
  }

  .research-list {
    margin-top: 2.5rem;
    border-top: 1px solid var(--home-border);
  }

  .news-list {
    margin-top: 2.5rem;
    border-top: 1px solid var(--home-border);
  }

