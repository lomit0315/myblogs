---
import { Image } from 'astro:assets'
import { getBlogCollectionEn, sortMDByDate } from '@/server'

import { Icon, SimpleIcon } from '@/components/user'
import avatar from '@/assets/profile-avatar.jpg'
import lhtbLeaderboard from '@/assets/publications/lhtb-leaderboard.png'
import recursiveSynthesisFigure from '@/assets/publications/recursive-synthesis.png'

const scholarUrl = 'https://scholar.google.com/citations?user=gGpfUL4AAAAJ&hl=en'
const linkedinUrl = 'https://www.linkedin.com/in/anhao-andy-li-b34b1b324/'
const githubUrl = 'https://github.com/lomit0315'
const umnUrl = 'https://twin-cities.umn.edu/'
const email = 'li003978@umn.edu'
const personalEmail = 'andy.anhao.li@gmail.com'

// Top bar: in-page sections first, then Blog and CV.
const navItems = [
  { label: 'About Me', href: '#about-me' },
  { label: 'News', href: '#news' },
  { label: 'Publications', href: '#publications' },
  { label: 'Honors', href: '#honors-and-awards' },
  { label: 'Education', href: '#education' },
  { label: 'Internships', href: '#internships' },
  { label: 'Service', href: '#service' },
  { label: 'Misc', href: '#misc' },
  { label: 'Blog', href: '/en/blog' },
  { label: 'CV', href: '/cv.pdf', external: true }
]

const publications = [
  {
    title: 'Recursive Synthesis for Long-Horizon Terminal Tasks',
    authors: [
      'Zhongzhi Li',
      'Yucheng Shi',
      'Zongxia Li',
      'Ruhan Wang',
      'Anhao Li',
      'Zixun Huang',
      'Junyao Yang',
      'Lei Ke',
      'Ninghao Liu',
      'Haitao Mi',
      'Leowei Liang'
    ],
    badge: 'arXiv 2026',
    summary:
      'A recursive, verification-driven pipeline that synthesizes progressively harder terminal tasks, giving agents a training and evaluation signal that scales with their capability.',
    paper: 'https://arxiv.org/abs/2608.05466',
    project:
      'https://zhongzhi660.github.io/recursive-verified-synthesis-site/?case=jobs-diff-01-3341b098',
    image: recursiveSynthesisFigure,
    imageAlt:
      'Recursive verified synthesis loop for generating increasingly difficult terminal tasks',
    // The figure is a wide diagram, so show all of it instead of cropping.
    imageFit: 'contain'
  },
  {
    title:
      'Long-Horizon-Terminal-Bench: Testing the Limits of Agents on Long-Horizon Terminal Tasks with Dense Reward-Based Grading',
    authors: [
      'Zongxia Li',
      'Zhongzhi Li',
      'Yucheng Shi',
      'Ruhan Wang',
      'Junyao Yang',
      'Zhichao Liu',
      'Xiyang Wu',
      'Anhao Li',
      'Yue Yu',
      'Ninghao Liu',
      'Lichao Sun',
      'Haotao Mi',
      'Leowei Liang'
    ],
    badge: 'arXiv 2026',
    summary:
      'A benchmark for agents on extended terminal tasks, replacing pass/fail checks with dense reward-based grading so partial progress is measured rather than discarded.',
    paper: 'https://arxiv.org/abs/2607.08964',
    project: 'https://zli12321.github.io/LHTB/',
    image: lhtbLeaderboard,
    imageAlt: 'Long-Horizon Terminal-Bench leaderboard showing model performance',
    // A tall leaderboard: crop to the top rows.
    imageFit: 'cover'
  }
]

// The homepage is in English, so link the English rendering of each post.
const recentPosts = sortMDByDate(await getBlogCollectionEn()).slice(0, 3)
const formatMonth = (date: Date | string) => {
  const d = new Date(date)
  return `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, '0')}`
}

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Anhao Li',
  alternateName: 'lomit',
  url: 'https://www.lomit.top/',
  email: [email, personalEmail],
  jobTitle: 'Computer Science Undergraduate',
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Minnesota Twin Cities'
  },
  sameAs: [scholarUrl, githubUrl, linkedinUrl],
  knowsAbout: [
    'AI Agents',
    'Self-Evolving Agents',
    'Large Language Models',
    'Post-training',
    'Reinforcement Learning',
    'Long-horizon terminal tasks',
    'Competitive Programming'
  ]
})
---

<a class='skip-link' href='#main-content'>Skip to content</a>

<header class='masthead'>
  <nav class='masthead-inner' aria-label='Primary navigation'>
    <a class='masthead-title' href='/' aria-current='page'>Homepage</a>
    <ul class='nav-links'>
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noreferrer' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <button
      class='theme-toggle'
      id='personal-theme-toggle'
      type='button'
      aria-label='Toggle color theme'
    >
      <Icon name='moon' class='icon-moon' />
      <Icon name='sun' class='icon-sun' />
    </button>
  </nav>
</header>

<div class='page-layout'>
  <aside class='sidebar' aria-label='Profile'>
    <Image
      src={avatar}
      alt='Portrait of Anhao Li'
      class='avatar'
      width={175}
      height={175}
      densities={[1, 2]}
      loading='eager'
    />
    <div class='author-text'>
      <h1 class='author-name'>Anhao Li</h1>
      <p class='author-affiliation'>University of Minnesota Twin Cities</p>
      <p class='author-bio'>CS Undergrad @ UMN | AI Agents &amp; LLMs | ICPC World Finalist</p>
    </div>
    <ul class='author-urls'>
      <li>
        <span><Icon name='location' />Minneapolis, MN, USA</span>
      </li>
      <li>
        <a href={`mailto:${email}`}><Icon name='email' />Email</a>
      </li>
      <li>
        <a href={`mailto:${personalEmail}`}><Icon name='email' />Gmail</a>
      </li>
      <li class='scholar'>
        <a href={scholarUrl} target='_blank' rel='noreferrer'
          ><SimpleIcon name='googlescholar' size='16' />Google Scholar</a
        >
      </li>
      <li>
        <a href={githubUrl} target='_blank' rel='noreferrer'><Icon name='github' />GitHub</a>
      </li>
      <li>
        <a href={linkedinUrl} target='_blank' rel='noreferrer'
          ><span class='linkedin-mark' aria-hidden='true'></span>LinkedIn</a
        >
      </li>
      <li>
        <a href='/cv.pdf' target='_blank' rel='noreferrer'><Icon name='document' />CV</a>
      </li>
    </ul>
  </aside>

  <main class='content' id='main-content'>
    <section id='about-me' aria-label='About me'>
      <p>Welcome to my homepage!</p>
      <p>
        I am a Computer Science undergraduate at the
        <a href={umnUrl} target='_blank' rel='noreferrer'>University of Minnesota Twin Cities</a>. I
        work on AI agents and large language models — self-evolving agents, agent harnesses, and
        reinforcement learning for long-horizon terminal tasks. I build agent infrastructure and the
        benchmarks used to evaluate it.
      </p>
      <p>My current research interests include:</p>
      <p>
        (1) <strong>Self-evolving agents.</strong> Agents that improve from their own execution traces
        — synthesizing harder tasks, verifying their own outcomes, and feeding what survives back in as
        training signal.
      </p>
      <p>
        (2) <strong>Agent harnesses.</strong> The scaffolding around the model: tool interfaces, context
        management, and execution environments. How much of a model's capability actually shows up on
        a task often depends on the harness as much as the weights.
      </p>
      <p>
        (3) <strong>Post-training.</strong> Turning a base model into a dependable agent — supervised
        fine-tuning, preference optimization, and the data synthesis pipelines that feed them.
      </p>
      <p>
        (4) <strong>Reinforcement learning.</strong> Reward design and credit assignment for agents acting
        over long horizons, where a single pass/fail at the end says very little about where the run actually
        went wrong.
      </p>

      <figure class='about-figure'>
        <Image
          src={recursiveSynthesisFigure}
          alt='Diagram of the recursive synthesis loop: synthesize a harder task, verify it, and train on solved rollouts'
          widths={[700, 1400]}
          sizes='(max-width: 760px) 100vw, 700px'
        />
        <figcaption>
          The recursive synthesis loop from our latest work: the agent synthesizes a harder task,
          iterates until it is oracle-valid, and keeps improving by training on the solved rollouts.
        </figcaption>
      </figure>

      <p>
        Outside research, I have competed in algorithm contests for about ten years, from NOI and
        USACO to the ICPC World Finals, and now coach the UMN team.
        <strong
          >Feel free to reach out if you want to talk about agents, evaluation, or contest problems!</strong
        >
      </p>
    </section>

    <section id='news'>
      <h2 class='section-title'>🔥 News</h2>
      <div class='news-box'>
        <ul>
          <li>
            <em>2026.08</em>: 🎉🎉 Our paper
            <a href='https://arxiv.org/abs/2608.05466' target='_blank' rel='noreferrer'
              >Recursive Synthesis for Long-Horizon Terminal Tasks</a
            > is now available on arXiv.
          </li>
          <li>
            <em>2026.07</em>: 🎉🎉 We released
            <a href='https://arxiv.org/abs/2607.08964' target='_blank' rel='noreferrer'
              >Long-Horizon-Terminal-Bench</a
            >, a benchmark for evaluating agents on extended terminal tasks.
          </li>
          <li>
            <em>2026.07</em>: 💼 Completed my second software engineering internship at VecML in
            Bellevue, WA, working on LLM agent infrastructure.
          </li>
          <li>
            <em>2026.03</em>: 🏆 Qualified for the <strong>ICPC World Finals</strong> — ranked 9th in
            North America at ICPC NAC, the first UMN team to qualify in 10 years.
          </li>
          <li>
            <em>2025.11</em>: 🥇 Won <strong>Gold</strong> at the ICPC North Central NA Regional Contest,
            our second consecutive regional gold.
          </li>
          <li>
            <em>2025.08</em>: 💼 Completed a software engineering internship at VecML in Bellevue,
            WA, building an AI data analysis platform.
          </li>
          <li>
            <em>2024.11</em>: 🥇 Won <strong>Gold</strong> at the ICPC North Central NA Regional Contest.
          </li>
          <li>
            <em>2024.09</em>: 🎓 Started my Bachelor's in Computer Science at the
            <a href={umnUrl} target='_blank' rel='noreferrer'>University of Minnesota Twin Cities</a
            >.
          </li>
        </ul>
      </div>
    </section>

    <section id='publications'>
      <h2 class='section-title'>📝 Publications</h2>
      <p class='section-note'>
        You can also find my papers on <a href={scholarUrl} target='_blank' rel='noreferrer'
          >Google Scholar</a
        >.
      </p>
      {
        publications.map((publication) => (
          <div class='paper-box'>
            <div class='paper-box-image'>
              <span class='badge'>{publication.badge}</span>
              <a
                href={publication.project}
                target='_blank'
                rel='noreferrer'
                aria-label={`Project page for ${publication.title}`}
              >
                <Image
                  src={publication.image}
                  alt={publication.imageAlt}
                  class:list={['paper-image', `fit-${publication.imageFit}`]}
                  width={640}
                  loading='lazy'
                />
              </a>
            </div>
            <div class='paper-box-text'>
              <p class='paper-title'>
                <a href={publication.paper} target='_blank' rel='noreferrer'>
                  {publication.title}
                </a>
              </p>
              <p class='paper-authors'>
                {publication.authors.map((author, index) => (
                  <>
                    {author === 'Anhao Li' ? <strong>{author}</strong> : author}
                    {index < publication.authors.length - 1 ? ', ' : ''}
                  </>
                ))}
              </p>
              <p class='paper-links'>
                <span>
                  <a href={publication.paper} target='_blank' rel='noreferrer'>
                    Paper
                  </a>
                </span>
                <span>
                  <a href={publication.project} target='_blank' rel='noreferrer'>
                    Project
                  </a>
                </span>
              </p>
              <ul>
                <li>{publication.summary}</li>
              </ul>
            </div>
          </div>
        ))
      }
    </section>

    <section id='honors-and-awards'>
      <h2 class='section-title'>🎖 Honors and Awards</h2>
      <ul>
        <li>
          <em>2026.03</em>
          <strong>ICPC World Finalist 2026</strong>, ranked 9th in North America at ICPC NAC; the
          first UMN team to qualify in 10 years.
        </li>
        <li>
          <em>2025.11, 2024.11</em>
          <strong>Gold Medal</strong>, ICPC North Central NA Regional Contest, in two consecutive
          years.
        </li>
        <li>
          <em>6×</em>
          <strong>First Prize</strong>, NOIP / CSP.
        </li>
        <li>
          <em>2021.12</em>
          <strong>USACO Platinum</strong>, ranked among the global top 30.
        </li>
        <li>
          <em>2021.07</em>
          <strong>Bronze Medal</strong>, National Olympiad in Informatics (NOI).
        </li>
        <li>
          <em>2021.01</em>
          <strong>Silver Medal</strong>, National Olympiad in Informatics Winter Camp.
        </li>
      </ul>
    </section>

    <section id='education'>
      <h2 class='section-title'>📖 Education</h2>
      <ul>
        <li>
          <em>2024.09 – present</em>, Bachelor's in Computer Science,
          <a href={umnUrl} target='_blank' rel='noreferrer'>University of Minnesota Twin Cities</a>,
          Minneapolis, MN. GPA: 3.96 / 4.0.
        </li>
      </ul>
    </section>

    <section id='internships'>
      <h2 class='section-title'>💻 Internships</h2>
      <ul>
        <li>
          <em>2026.05 – 2026.07</em>, Software Engineer Intern, <strong>VecML Inc.</strong> (AI startup),
          Bellevue, WA. LLM agent infrastructure and evaluation.
        </li>
        <li>
          <em>2025.06 – 2025.08</em>, Software Engineer Intern, <strong>VecML Inc.</strong> (AI startup),
          Bellevue, WA. AI data analysis platform.
        </li>
      </ul>
    </section>

    <section id='service'>
      <h2 class='section-title'>🧑‍🏫 Teaching &amp; Service</h2>
      <ul>
        <li>
          <em>2026 – 2027</em>, <strong>ICPC Coach</strong>, University of Minnesota: practice
          contests, training plans, and problem-set design.
        </li>
        <li>
          <em>Ongoing</em>, <strong>Competitive programming mentoring</strong>: contest editorials
          and training notes on my <a href='/en/blog'>blog</a>, and mentoring students moving from
          introductory algorithms to ICPC-level problems.
        </li>
      </ul>
    </section>

    <section id='misc'>
      <h2 class='section-title'>🪄 Misc</h2>
      <p>
        I write contest write-ups, technical notes, and the occasional reflection on my
        <a href='/en/blog'>blog</a>. Every post is available in English and Chinese. Recent posts:
      </p>
      <ul>
        {
          recentPosts.map((post) => (
            <li>
              <em>{formatMonth(post.data.publishDate)}</em>{' '}
              <a href={`/en/blog/${post.id}`}>{post.data.title}</a>
            </li>
          ))
        }
      </ul>
      <p>
        Email is the fastest way to reach me: <a href={`mailto:${email}`}>{email}</a> or
        <a href={`mailto:${personalEmail}`}>{personalEmail}</a>.
      </p>
    </section>
  </main>
</div>

<footer class='page-footer'>
  <p>© {new Date().getFullYear()} Anhao Li</p>
</footer>

<script is:inline type='application/ld+json' set:html={jsonLd} />

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('#personal-theme-toggle')
  themeToggle?.addEventListener('click', () => {
    const nextTheme = document.documentElement.classList.contains('dark') ? 'light' : 'dark'
    try {
      localStorage.setItem('theme', nextTheme)
    } catch {
      // Storage can be blocked (e.g. private mode); the toggle still works for this visit.
    }
    document.documentElement.classList.toggle('dark', nextTheme === 'dark')
    document
      .querySelectorAll('meta[name="theme-color"]')
      .forEach((meta) => meta.setAttribute('content', nextTheme === 'dark' ? '#121417' : '#ffffff'))
  })
</script>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--home-border);
    border-radius: 0.4rem;
    background: var(--home-background);
    color: var(--home-foreground);
    transform: translateY(-150%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  /* === Top bar === */

  .masthead {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--home-border);
    background: color-mix(in srgb, var(--home-background) 94%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
  }

  .masthead-inner {
    display: flex;
    max-width: var(--home-max-width);
    height: var(--home-masthead-height);
    margin: 0 auto;
    padding: 0 1.5rem;
    align-items: center;
    gap: 1.6rem;
  }

  .masthead-title,
  .nav-links a {
    position: relative;
    display: block;
    padding: 0.6rem 0;
    white-space: nowrap;
    text-decoration: none;
  }

  .masthead-title {
    flex: none;
    color: var(--home-foreground);
    font-weight: 600;
  }

  .nav-links {
    display: flex;
    min-width: 0;
    margin: 0;
    padding: 0;
    flex: 1 1 auto;
    gap: 1.6rem;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  .nav-links a {
    color: var(--home-nav);
    transition: color 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--home-foreground);
  }

  /* Gray bar under the current page, and under nav links on hover. */
  .masthead-title::after,
  .nav-links a::after {
    position: absolute;
    right: 0;
    bottom: 0.2rem;
    left: 0;
    height: 3px;
    background: var(--home-nav-bar);
    content: '';
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .masthead-title::after,
  .nav-links a:hover::after,
  .nav-links a:focus-visible::after {
    transform: scaleX(1);
  }

  .theme-toggle {
    display: grid;
    width: 2rem;
    height: 2rem;
    margin-left: auto;
    padding: 0;
    flex: none;
    place-items: center;
    border: 1px solid var(--home-border);
    border-radius: 50%;
    background: transparent;
    color: var(--home-nav);
    cursor: pointer;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    border-color: var(--home-nav-bar);
    color: var(--home-foreground);
  }

  .theme-toggle :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .theme-toggle :global(.icon-sun),
  :global(.dark) .theme-toggle :global(.icon-moon) {
    display: none;
  }

  :global(.dark) .theme-toggle :global(.icon-sun) {
    display: block;
  }

  /* === Page: sticky profile on the left, content on the right === */

  .page-layout {
    display: grid;
    max-width: var(--home-max-width);
    margin: 0 auto;
    padding: 2.75rem 1.5rem 4rem;
    grid-template-columns: 16.25rem minmax(0, 1fr);
    align-items: start;
    gap: 3.25rem;
  }

  .sidebar {
    position: sticky;
    top: calc(var(--home-masthead-height) + 2rem);
  }

  .avatar {
    display: block;
    width: 175px;
    height: 175px;
    padding: 5px;
    border: 1px solid var(--home-border);
    border-radius: 50%;
    background: var(--home-background);
    object-fit: cover;
  }

  .author-name {
    margin: 1.1rem 0 0.2rem;
    color: var(--home-foreground);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .author-affiliation {
    margin: 0;
    color: var(--home-text);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .author-bio {
    margin: 0.65rem 0 0;
    color: var(--home-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .author-urls {
    display: grid;
    margin: 1.25rem 0 0;
    padding: 0;
    gap: 0.55rem;
    list-style: none;
    font-size: 0.94rem;
  }

  .author-urls li > * {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--home-text);
    text-decoration: none;
  }

  .author-urls a:hover,
  .author-urls a:focus-visible {
    color: var(--home-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .author-urls :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    color: var(--home-foreground);
  }

  .author-urls .scholar :global(svg) {
    color: #4285f4;
  }

  :global(.dark) .author-urls .scholar :global(svg) {
    color: #8ab4f8;
  }

  .linkedin-mark {
    display: grid;
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    place-items: center;
    border-radius: 3px;
    background: #0a66c2;
  }

  .linkedin-mark::after {
    color: #ffffff;
    content: 'in';
    font:
      800 0.66rem/1 Arial,
      sans-serif;
  }

  :global(.dark) .linkedin-mark {
    background: #70b5f9;
  }

  :global(.dark) .linkedin-mark::after {
    color: var(--home-background);
  }

  /* === Content === */

  .content {
    min-width: 0;
    color: var(--home-text);
    font-size: 1rem;
    line-height: 1.72;
  }

  .content p {
    margin: 0 0 1rem;
  }

  .content a {
    color: var(--home-link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .content a:hover,
  .content a:focus-visible {
    color: var(--home-link-hover);
  }

  .content strong {
    color: var(--home-foreground);
    font-weight: 650;
  }

  .content em {
    font-style: italic;
  }

  .content ul {
    margin: 0 0 1rem;
    padding-left: 1.3rem;
    list-style: disc;
  }

  .content li {
    margin: 0 0 0.45rem;
    padding-left: 0.15rem;
  }

  .content li::marker {
    color: var(--home-muted);
  }

  .section-title {
    margin: 2.75rem 0 1.1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--home-border);
    color: var(--home-foreground);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .section-note {
    color: var(--home-muted);
  }

  .about-figure {
    margin: 1.75rem 0 1.5rem;
  }

  .about-figure :global(img) {
    display: block;
    width: min(100%, 700px);
    margin: 0 auto;
