    description: 'Ranked 9th in North America at ICPC NAC, becoming the first UMN team to qualify in 10 years.',
    href: '#awards'
  },
  {
    date: 'Nov 2025',
    category: 'ICPC',
    title: 'Gold at the North Central NA Regional Contest',
    description: 'Won a second consecutive regional gold medal after our 2024 result.',
    href: '#awards'
  },
  {
    date: 'Aug 2025',
    category: 'Internship',
    title: 'AI Data Analysis Platform at VecML',
    description: 'Completed a software engineering internship at VecML in Bellevue, WA.',
    href: '#experience'
  }
]

const researchInterests = [
  {
    number: '01',
    title: 'AI Agents',
    description: 'Developing autonomous systems that integrate planning, reasoning, tool use, and feedback to solve complex, long-horizon tasks.'
  },
  {
    number: '02',
    title: 'Large Language Models',
    description: 'Investigating post-training, evaluation, and inference-time methods that improve the capability and reliability of language models.'
  },
  {
    number: '03',
    title: 'Long-horizon Tasks',
    description: 'Building environments, benchmarks, and verification methods for measuring sustained progress across extended workflows.'
  },
  {
    number: '04',
    title: 'Algorithms & Competitive Programming',
    description: 'Studying algorithm design and optimization through ICPC, with an emphasis on rigorous reasoning under tight computational constraints.'
  }
]

const experiences = [
  {
    period: 'May 2026 – Jul 2026',
    role: 'Software Engineer Intern',
    focus: 'LLM Agent Infrastructure & Evaluation',
    company: 'VecML Inc. (AI startup)',
    location: 'Bellevue, WA'
  },
  {
    period: 'Jun 2025 – Aug 2025',
    role: 'Software Engineer Intern',
    focus: 'AI Data Analysis Platform',
    company: 'VecML Inc. (AI startup)',
    location: 'Bellevue, WA'
  }
]

const awards = [
  {
    period: 'Mar 2026',
    title: 'ICPC World Finalist 2026',
    description: 'Ranked 9th in North America at ICPC NAC; first UMN team to qualify in 10 years.'
  },
  {
    period: 'Nov 2025 · Nov 2024',
    title: 'Gold Medal — ICPC North Central NA Regional Contest',
    description: 'Gold medalist in two consecutive regional contests.'
  },
  {
    period: '6× total',
    title: 'NOIP / CSP First Prize',
