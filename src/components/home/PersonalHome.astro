    border-bottom: 1px solid var(--home-border);
  }

  .news-date {
    margin: 0;
    padding-top: 0.15rem;
    color: var(--home-muted);
    font-family: 'ComicShannsMono', monospace;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .news-category {
    margin: 0 0 0.25rem;
    color: var(--home-accent);
    font-size: 0.68rem;
    font-weight: 720;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .news-content h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 680;
    line-height: 1.4;
  }

  .news-content h3 a {
    text-decoration: none;
  }

  .news-content h3 a:hover,
  .news-content h3 a:focus-visible {
    color: var(--home-accent);
  }

  .news-content > p:last-child {
    margin: 0.3rem 0 0;
    color: var(--home-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .research-item {
    display: grid;
    padding: 1.6rem 0;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    border-bottom: 1px solid var(--home-border);
  }

  .research-number {
    padding-top: 0.15rem;
    color: var(--home-accent);
    font-family: 'ComicShannsMono', monospace;
    font-size: 0.78rem;
  }

  .research-item h3 {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 680;
  }

  .research-item p {
