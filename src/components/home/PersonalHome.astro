      'Zhongzhi Li',
      'Yucheng Shi',
      'Zongxia Li',
      'Ruhan Wang',
      'Anhao Li',
      'Zixun Huang',
      'Junyao Yang',
      'Lei Ke',
      'Ninghao Liu',
      'Haitao Mi',
      'Leowei Liang'
    ],
    venue: 'arXiv preprint',
    year: '2026',
    href: 'https://arxiv.org/abs/2608.05466',
    website: 'https://zhongzhi660.github.io/recursive-verified-synthesis-site/?case=jobs-diff-01-3341b098',
    image: recursiveSynthesisFigure,
    imageAlt: 'Recursive verified synthesis loop for generating increasingly difficult terminal tasks'
  },
  {
    title:
      'Long-Horizon-Terminal-Bench: Testing the Limits of Agents on Long-Horizon Terminal Tasks with Dense Reward-Based Grading',
    authors: [
      'Zongxia Li',
      'Zhongzhi Li',
      'Yucheng Shi',
      'Ruhan Wang',
      'Junyao Yang',
      'Zhichao Liu',
      'Xiyang Wu',
      'Anhao Li',
      'Yue Yu',
      'Ninghao Liu',
      'Lichao Sun',
      'Haotao Mi',
      'Leowei Liang'
    ],
    venue: 'arXiv preprint',
    year: '2026',
    href: 'https://arxiv.org/abs/2607.08964',
