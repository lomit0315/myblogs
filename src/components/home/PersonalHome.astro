---

<a class='skip-link' href='#main-content'>Skip to content</a>

<header class='site-header'>
  <nav class='nav-shell' aria-label='Primary navigation'>
    <a class='brand' href='/' aria-label='Anhao Li home'>Anhao Li</a>
    <div class='nav-links'>
      <a href='#about'>About</a>
      <a href='#news'>News</a>
      <a href='#experience'>Experience</a>
      <a href='#publications'>Publications</a>
      <a href='#awards'>Awards</a>
      <a class='cv-link' href='/cv.pdf' target='_blank' rel='noreferrer'>CV</a>
      <a class='blog-link' href='/blog'>Blog</a>
      <button class='theme-toggle' id='personal-theme-toggle' type='button' aria-label='Toggle color theme'>
        <span aria-hidden='true'>◐</span>
      </button>
    </div>
  </nav>
</header>

<main class='page-shell' id='main-content'>
  <aside class='profile-card' aria-label='Profile'>
    <Image
      src={avatar}
      alt='Anhao Li avatar'
      class='avatar'
      width={220}
      height={220}
      loading='eager'
    />
    <div>
      <p class='profile-name'>Anhao Li</p>
      <p class='profile-role'>Computer Science Undergraduate</p>
      <a class='university' href='https://twin-cities.umn.edu/' target='_blank' rel='noreferrer'>
        University of Minnesota Twin Cities
      </a>
    </div>
    <div class='profile-links' aria-label='Profile links'>
      <a href={`mailto:${email}`} aria-label='Email Anhao Li'>
        <span class='profile-link-main'>
          <span class='profile-link-icon'><Icon name='email' /></span>
          <span>Email</span>
        </span>
        <span aria-hidden='true'>↗</span>
      </a>
      <a href={scholarUrl} target='_blank' rel='noreferrer'>
        <span class='profile-link-main'>
          <span class='profile-link-icon'><SimpleIcon name='googlescholar' size='16' /></span>
          <span>Google Scholar</span>
        </span>
        <span aria-hidden='true'>↗</span>
      </a>
      <a href='https://github.com/lomit0315' target='_blank' rel='noreferrer'>
        <span class='profile-link-main'>
          <span class='profile-link-icon'><Icon name='github' /></span>
          <span>GitHub</span>
        </span>
        <span aria-hidden='true'>↗</span>
      </a>
      <a href={linkedinUrl} target='_blank' rel='noreferrer'>
        <span class='profile-link-main'>
          <span class='profile-link-icon'><span class='linkedin-mark' aria-hidden='true'>in</span></span>
          <span>LinkedIn</span>
        </span>
        <span aria-hidden='true'>↗</span>
      </a>
      <a href='/blog'>
        <span class='profile-link-main'>
          <span class='profile-link-icon'><Icon name='document' /></span>
          <span>Personal blog</span>
        </span>
        <span aria-hidden='true'>→</span>
      </a>
    </div>
  </aside>

  <div class='content-column'>
    <section class='intro-section' id='about'>
      <p class='eyebrow'>AI AGENTS · LARGE LANGUAGE MODELS</p>
      <h1>Hi, I’m <span>Anhao Li.</span></h1>
      <p class='lead'>
        I am a Computer Science undergraduate at the University of Minnesota Twin Cities. My work
        centers on AI agents and large language models, with a particular focus on long-horizon
        terminal tasks.
      </p>
      <p class='intro-note'>
        I build practical agent systems and evaluation tools. Outside research and engineering, I
        compete in ICPC and coach competitive programming.
      </p>
    </section>

    <section class='section news-section' id='news'>
      <div class='section-heading'>
        <h2>News</h2>
      </div>
      <div class='news-list'>
        {
          news.map((item) => (
            <article class='news-item'>
              <p class='news-date'>{item.date}</p>
              <div class='news-content'>
                <p class='news-category'>{item.category}</p>
                <h3>
                  <a
                    href={item.href}
                    target={item.href.startsWith('http') ? '_blank' : undefined}
                    rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
                  >
                    {item.title}{item.href.startsWith('http') ? ' ↗' : ' →'}
                  </a>
                </h3>
                <p>{item.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class='section' id='research'>
      <div class='section-heading'>
        <h2>Research Interests</h2>
      </div>
      <div class='research-list'>
        {
          researchInterests.map((interest) => (
            <article class='research-item'>
              <span class='research-number'>{interest.number}</span>
              <div>
                <h3>{interest.title}</h3>
                <p>{interest.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class='section' id='experience'>
      <div class='section-heading'>
        <h2>Experience</h2>
      </div>
      <div class='experience-list'>
        {
          experiences.map((experience) => (
            <article class='experience-item'>
              <p class='experience-period'>{experience.period}</p>
              <div class='experience-content'>
                <h3>{experience.role}</h3>
                <p class='experience-focus'>{experience.focus}</p>
                <p class='company-line'>{experience.company} · {experience.location}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class='section' id='publications'>
      <div class='section-heading publication-heading'>
        <h2>Selected Publications</h2>
        <a href={scholarUrl} target='_blank' rel='noreferrer'>All on Scholar ↗</a>
      </div>
      <div class='publication-list'>
        {
          publications.map((publication) => (
            <article class='publication-item'>
              <a
                class='publication-visual'
                href={publication.website}
                target='_blank'
                rel='noreferrer'
                aria-label={`Visit the project site for ${publication.title}`}
              >
                <Image
                  src={publication.image}
                  alt={publication.imageAlt}
                  class='publication-image'
                  loading='lazy'
                />
              </a>
              <div class='publication-content'>
                <p class='publication-year'>{publication.year}</p>
                <h3>
                  <a href={publication.href} target='_blank' rel='noreferrer'>{publication.title}</a>
                </h3>
                <p class='authors'>
                  {publication.authors.map((author, index) => (
                    <>
                      {author === 'Anhao Li' ? <strong>{author}</strong> : author}
                      {index < publication.authors.length - 1 ? ', ' : ''}
                    </>
                  ))}
                </p>
                <div class='publication-meta'>
                  <span>{publication.venue}</span>
                  <a href={publication.href} target='_blank' rel='noreferrer'>Paper ↗</a>
                  <a href={publication.website} target='_blank' rel='noreferrer'>Project site ↗</a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class='section' id='awards'>
      <div class='section-heading'>
        <h2>Honors & Awards</h2>
      </div>
      <div class='award-list'>
        {
          awards.map((award) => (
            <article class='award-item'>
              <div class='award-content'>
                <h3>{award.title}</h3>
                <p>{award.description}</p>
              </div>
              <p class='award-period'>{award.period}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class='section education-section' id='education'>
      <div class='section-heading'>
        <h2>Education</h2>
      </div>
      <div class='education-heading'>
        <h3>University of Minnesota Twin Cities</h3>
        <p class='education-period'>Sep 2024 – Present</p>
      </div>
      <div class='education-details'>
        <div class='education-detail'>
          <p>Major</p>
          <p>Computer Science</p>
        </div>
        <div class='education-detail'>
          <p>GPA</p>
          <p>3.96 / 4.0</p>
        </div>
        <div class='education-detail'>
          <p>Activities</p>
          <p>Competitive Programming · ICPC Contestant · ICPC Coach, 2026–2027</p>
        </div>
      </div>
    </section>

    <section class='blog-callout' aria-labelledby='blog-callout-title'>
      <div>
        <p class='section-kicker'>Beyond research</p>
        <h2 id='blog-callout-title'>Notes on programming, competitions, and everyday life.</h2>
      </div>
      <a href='/blog'>Visit the blog <span>→</span></a>
    </section>
  </div>
</main>

<footer class='personal-footer'>
  <p>© {new Date().getFullYear()} Anhao Li</p>
  <p>Research, code, and notes.</p>
</footer>

<script is:inline type='application/ld+json' set:html={jsonLd} />

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('#personal-theme-toggle')
  themeToggle?.addEventListener('click', () => {
    const nextTheme = document.documentElement.classList.contains('dark') ? 'light' : 'dark'
    localStorage.setItem('theme', nextTheme)
    document.documentElement.classList.toggle('dark', nextTheme === 'dark')
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', nextTheme === 'dark' ? '#131516' : '#f8f8f6')
  })
</script>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--home-border);
    border-radius: 0.5rem;
    background: var(--home-surface);
    transform: translateY(-150%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid color-mix(in srgb, var(--home-border) 82%, transparent);
    background: color-mix(in srgb, var(--home-background) 92%, transparent);
    backdrop-filter: blur(12px);
  }

  .nav-shell {
    display: flex;
    width: min(1080px, calc(100% - 2.5rem));
    min-height: 4.5rem;
    margin: 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    font-size: 1rem;
    font-weight: 720;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    color: var(--home-muted);
    font-size: 0.9rem;
  }

  .nav-links a {
    text-decoration: none;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--home-accent);
  }

  .blog-link {
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--home-border);
    border-radius: 999px;
    color: var(--home-foreground) !important;
  }

  .theme-toggle {
    display: grid;
    width: 2rem;
    height: 2rem;
    padding: 0;
    place-items: center;
    border: 1px solid var(--home-border);
    border-radius: 50%;
    background: transparent;
    color: var(--home-foreground);
    cursor: pointer;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible,
  .blog-link:hover,
  .blog-link:focus-visible {
    border-color: var(--home-accent);
  }

  .page-shell {
    display: grid;
    width: min(1080px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 5.25rem 0 7rem;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
  }

  .profile-card {
    position: sticky;
    top: 7.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .avatar {
    width: 11rem;
    height: 11rem;
    border: 1px solid var(--home-border);
    border-radius: 50%;
    background: var(--home-surface);
    object-fit: cover;
  }

  .profile-name {
    margin: 0 0 0.25rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .profile-role,
  .university {
    margin: 0;
    color: var(--home-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .university {
    display: inline-block;
    margin-top: 0.2rem;
    text-decoration-color: var(--home-border);
    text-underline-offset: 0.2rem;
  }

  .profile-links {
    display: flex;
    padding-top: 1rem;
    flex-direction: column;
    gap: 0.7rem;
    border-top: 1px solid var(--home-border);
  }

  .profile-links a {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--home-muted);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .profile-links a:hover,
  .profile-links a:focus-visible {
    color: var(--home-accent);
  }

  .profile-link-main {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.65rem;
  }

  .profile-link-main > span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .profile-link-icon {
    display: grid;
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    place-items: center;
    color: var(--home-foreground);
  }

  .profile-link-icon :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .linkedin-mark {
    display: grid;
    width: 1rem;
    height: 1rem;
    place-items: center;
    border-radius: 0.12rem;
    background: var(--home-foreground);
    color: var(--home-background);
    font-family: Arial, sans-serif;
    font-size: 0.67rem;
    font-weight: 800;
    line-height: 1;
  }

  .content-column {
    min-width: 0;
  }

  .intro-section {
    padding-bottom: 5.5rem;
    border-bottom: 1px solid var(--home-border);
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 1rem;
    color: var(--home-accent);
    font-size: 0.72rem;
    font-weight: 720;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    text-wrap: pretty;
  }

  .intro-section h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 7vw, 5.7rem);
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: -0.065em;
  }

  .intro-section h1 span {
    color: var(--home-accent);
  }

  .lead {
    max-width: 42rem;
    margin: 2.3rem 0 0;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.62;
    letter-spacing: -0.012em;
  }

  .intro-note {
    max-width: 40rem;
    margin: 1.15rem 0 0;
