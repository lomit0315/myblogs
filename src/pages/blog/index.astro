---
import { Button } from '@/components/user'
import { PostPreview } from '@/components/pages'
import PageLayout from '@/layouts/BaseLayout.astro'
import { getBlogCollection, getUniqueCategoriesWithCount, sortMDByDate } from '@/server'

const categoryNames: Record<string, string> = {
  icpc: 'ACM ICPC',
  research: 'Research',
  tech: 'Technical',
  daily: 'Daily Life',
  journal: 'Month Journal'
}

const posts = sortMDByDate(await getBlogCollection())
const categories = getUniqueCategoriesWithCount(posts)
const recentPosts = posts.slice(0, 10)

const meta = {
  title: 'Blog',
  description: 'Notes from Anhao Li on programming, competitive programming, research, and life.'
}
---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10'>
    <section class='animate mb-12' id='content-header'>
      <p class='mb-2 text-sm font-medium uppercase tracking-[0.14em] text-primary'>Notes & writing</p>
      <div class='flex flex-col justify-between gap-5 sm:flex-row sm:items-end'>
        <div>
          <h1 class='text-4xl font-semibold tracking-tight sm:text-5xl'>Blog</h1>
          <p class='mt-3 max-w-2xl text-muted-foreground'>
            Programming notes, contest write-ups, technical guides, and occasional reflections.
          </p>
        </div>
        <a class='text-sm text-muted-foreground hover:text-primary' href='/'>← Back to personal website</a>
      </div>
    </section>

    <section class='animate mb-12' id='content'>
      <h2 class='mb-4 text-sm font-medium uppercase tracking-[0.12em] text-muted-foreground'>Browse by topic</h2>
      <div class='flex flex-wrap gap-2'>
        {
          categories.map(([category, count]) => (
            <Button
              title={`${categoryNames[category] || category} · ${count}`}
              href={`/blog/${category}`}
              style='pill'
            />
          ))
        }
      </div>
    </section>

    <section aria-labelledby='recent-posts-title'>
      <div class='mb-5 flex items-end justify-between gap-4'>
        <h2 id='recent-posts-title' class='text-2xl font-semibold'>Recent posts</h2>
        <a class='text-sm text-muted-foreground hover:text-primary' href='/archives'>View archive →</a>
      </div>
      <ul class='flex flex-col gap-y-4'>
        {recentPosts.map((post) => <PostPreview {post} detailed />)}
      </ul>
    </section>
  </main>
</PageLayout>
