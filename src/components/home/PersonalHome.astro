const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Anhao Li',
  alternateName: 'lomit',
  url: 'https://www.lomit.top/',
  email,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Minnesota Twin Cities'
  },
  sameAs: [scholarUrl, 'https://github.com/lomit0315', linkedinUrl],
  knowsAbout: ['AI Agents', 'Large Language Models', 'Long-horizon terminal tasks']
